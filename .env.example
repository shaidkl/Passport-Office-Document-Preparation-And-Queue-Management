# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=passport.example.gov.np
DJANGO_CSRF_TRUSTED_ORIGINS=https://passport.example.gov.np

# PostgreSQL
DB_NAME=passport_db
DB_USER=passport_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# PostgreSQL table-owner credentials, loaded only by `python manage.py migrate`.
# The running web application continues to use the restricted DB_USER above.
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=replace-with-the-postgres-owner-password

# Real SMTP email delivery for citizen verification and personnel MFA
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.gov.np
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@passport.example.gov.np
PUBLIC_BASE_URL=https://passport.example.gov.np
EMAIL_VERIFICATION_TTL_SECONDS=300
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
EMAIL_VERIFICATION_IP_MAX_SENDS_PER_HOUR=20
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_OTP_ATTEMPT_WINDOW_SECONDS=900
EMAIL_VERIFICATION_OTP_CLEANUP_INTERVAL_SECONDS=5

# Authentication and abuse prevention
AUTH_TOKEN_TTL_MINUTES=720
AUTH_TOKEN_COOKIE_NAME=passport_session
AUTH_TOKEN_COOKIE_SECURE=true
AUTH_TOKEN_COOKIE_SAMESITE=Lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
PERSONNEL_MFA_REQUIRED=true
PERSONNEL_MFA_TTL_SECONDS=300
PERSONNEL_MFA_MAX_ATTEMPTS=5
PUBLIC_TRACKING_RATE=20/hour

# ClamAV upload scanner (required by default when DEBUG=false)
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20

# RSA passport signing. Prefer mounted secret files or a secrets manager.
PASSPORT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/passport-signing-private.pem
PASSPORT_SIGNING_PUBLIC_KEY_FILE=/run/secrets/passport-signing-public.pem
PASSPORT_SIGNING_KEY_ID=passport-production-2026

# eSewa production credentials
ESEWA_ENVIRONMENT=production
ESEWA_PRODUCT_CODE=replace-with-esewa-product-code
ESEWA_SECRET_KEY=replace-with-esewa-secret-key

# HTTPS and reverse-proxy security
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
TRUST_PROXY_SSL_HEADER=true

# Gunicorn container tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
